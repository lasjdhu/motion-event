{
  "name": "motion-event",
  "version": "1.0.0",
  "description": "Lightweight and efficient Expo module for handling raw motion events on Android",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "expo-source": "./src/index.ts",
      "default": "./build/index.js"
    }
  },
  "sideEffects": false,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "tsc -b tsconfig.json --clean",
    "lint": "eslint src/",
    "prepare": "pnpm build",
    "prepublishOnly": "pnpm clean && pnpm build",
    "style": "prettier --write .",
    "style:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "version:check": "node scripts/check-version.mjs",
    "validate": "pnpm version:check && pnpm style:check && pnpm lint && pnpm typecheck && pnpm build && pnpm pack --dry-run",
    "android:example": "pnpm --dir example android"
  },
  "platforms": [
    "android"
  ],
  "keywords": [
    "react-native",
    "expo",
    "motion-event",
    "MotionEvent",
    "touch",
    "pointer",
    "events"
  ],
  "files": [
    "android/src/main/**/*",
    "android/build.gradle",
    "build/**/*",
    "expo-module.config.json",
    "LICENSE",
    "README.md",
    "readme-assets/example.gif"
  ],
  "repository": "https://github.com/lasjdhu/motion-event",
  "bugs": {
    "url": "https://github.com/lasjdhu/motion-event/issues"
  },
  "author": "Dmitrii Ivanushkin <dmitrii.unwritten183@passmail.net> (https://github.com/lasjdhu)",
  "license": "MIT",
  "homepage": "https://github.com/lasjdhu/motion-event#readme",
  "devDependencies": {
    "@types/react": "~19.2.18",
    "expo": "^57.0.11",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^16.0.0",
    "prettier": "^3.9.6",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
